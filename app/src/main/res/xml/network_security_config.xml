<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS и только системные сертификаты: API-ключ и факты не могут уйти открытым текстом. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
